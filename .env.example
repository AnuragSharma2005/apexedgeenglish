# Apex Edge English - Environment Configuration Template
# Copy this file to .env and replace with your actual environment values

# Google Apps Script Web App URLs
VITE_ENROLL_SHEET_URL="https://script.google.com/macros/s/YOUR_ENROLLMENT_SCRIPT_ID/exec"
VITE_CONTACT_SHEET_URL="https://script.google.com/macros/s/YOUR_CONTACT_SCRIPT_ID/exec"

# FormSubmit & Contact Emails
VITE_FORMSUBMIT_EMAIL="your_email@example.com"
VITE_CONTACT_EMAIL="your_email@example.com"

# Contact Phone & WhatsApp
VITE_CONTACT_PHONE="+91 83600 79077"
VITE_WHATSAPP_NUMBER="918360079077"

# Admin Dashboard Credentials
VITE_ADMIN_EMAIL="admin@apexedge.com"
VITE_ADMIN_PASSWORD="your_secure_password"

